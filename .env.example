# =============================================================================
# Digital Study Carrel — Environment Configuration
# =============================================================================

# Google Gemini API Key (for text-embedding-004 and gemini-2.0-flash RAG answer synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for whisper-large-v3-turbo fast audio transcription with timestamps)
GROQ_API_KEY=your_groq_api_key_here

# Supabase PostgreSQL + pgvector configuration (Required for production persistence)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Set to 'true' ONLY for local offline testing with temporary in-memory store.
# When false or unset, the application strictly requires SUPABASE_URL and SUPABASE_KEY.
LOCAL_DEV=false
